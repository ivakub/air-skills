{
  "mcpServers": {
    "youtrack": {
      "type": "http",
      "url": "https://youtrack.jetbrains.com/mcp",
      "headers": {
        "Authorization": "Bearer ${YOUTRACK_TOKEN}"
      }
    },
    "teamcity-jb-internal": {
      "type": "http",
      "url": "https://buildserver.labs.intellij.net/app/mcp",
      "headers": {
        "Authorization": "Bearer ${TEAMCITY_TOKEN}"
      }
    }
  }
}
